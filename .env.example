# ── LifePilot environment ─────────────────────────────────────────────
# Copy to .env and adjust. All values shown are the defaults.

# Server
NODE_ENV=development
SERVER_PORT=4000
CLIENT_URL=http://localhost:5173

# MongoDB. Use a real URI for multi-process dev (server + mcp-server share it).
# Set "memory" to spin up an in-memory MongoDB (development only; per-process).
MONGODB_URI=mongodb://127.0.0.1:27017/lifepilot

# Auth (a JWT_SECRET is REQUIRED in production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# MCP internal service (server -> mcp-server). Must match in both processes.
MCP_SERVER_URL=http://127.0.0.1:4001/mcp
MCP_INTERNAL_TOKEN=change-me
MCP_SERVER_PORT=4001
MCP_HOST=127.0.0.1
MCP_TIMEOUT_MS=15000
# Browser origins allowed to call the MCP endpoint (DNS-rebinding defence,
# spec 2025-11-25). Non-browser callers send no Origin and are unaffected.
MCP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI provider routing: auto | npmai | mock
#   auto  -> NPMAI when NPMAI_BASE_URL is configured, otherwise local demo
#   npmai -> always try NPMAI (falls back to the local demo provider)
#   mock  -> local deterministic agent (tests, offline demos)
AI_PROVIDER=auto
# Fall back to the local deterministic provider when NPMAI is unreachable.
ALLOW_MOCK_FALLBACK=true

# NPMAI (optional). Free tier needs no key; NPMAI_API_KEY is only for a
# self-hosted gateway.
# To ENABLE NPMAI set NPMAI_BASE_URL to the live load balancer below (leave it
# empty to use the local demo provider — recommended, it is fast and reliable).
# WARNING: NPMAI's backend spaces sleep on the HF free tier and are frequently
# unreachable, so chat can take minutes before falling back. When NPMAI_BASE_URL
# is set, requests first hit it, then NPMAI_FALLBACK_BASE_URL, with NPMAI_RETRIES
# retries each.
AI_MAX_TOOL_ITERATIONS=6
AI_REQUEST_TIMEOUT_MS=45000
AI_TEMPERATURE=0.3
NPMAI_BASE_URL=
NPMAI_FALLBACK_BASE_URL=https://npmaiecosystem-loadbalancerfallback.hf.space/load_balancer
NPMAI_API_KEY=
NPMAI_MODEL=llama3.2
NPMAI_RETRIES=1

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_CHAT_MAX=30

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Seed the DB with a demo account on `npm run seed` (credentials below in README)
DEMO_SEED=true
DEMO_EMAIL=demo@lifepilot.app
DEMO_PASSWORD=demo1234