# ── LifePilot environment ─────────────────────────────────────────────
# Copy to .env and adjust. All values shown are the defaults.

# Server
NODE_ENV=development
SERVER_PORT=4000
CLIENT_URL=http://localhost:5173

# MongoDB. Use a real URI for multi-process dev (server + mcp-server share it).
# Set "memory" to spin up an in-memory MongoDB (development only; per-process).
MONGODB_URI=mongodb://127.0.0.1:27017/lifepilot

# Auth (a JWT_SECRET is REQUIRED in production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# MCP internal service (server -> mcp-server). Must match in both processes.
MCP_SERVER_URL=http://127.0.0.1:4001/mcp
MCP_INTERNAL_TOKEN=change-me
MCP_SERVER_PORT=4001
MCP_HOST=127.0.0.1
MCP_TIMEOUT_MS=15000
# Browser origins allowed to call the MCP endpoint (DNS-rebinding defence,
# spec 2025-11-25). Non-browser callers send no Origin and are unaffected.
MCP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI engine (local deterministic provider). Bounded JSON-ReAct loop knobs.
AI_MAX_TOOL_ITERATIONS=6
AI_REQUEST_TIMEOUT_MS=45000
AI_TEMPERATURE=0.3

# ── AWS: DynamoDB confirmation store (always-free tier) ───────────────
# Destructive-action confirmations are persisted here instead of in memory, so
# a confirmation survives restarts and works across multiple instances.
#   PENDING_ACTION_STORE:
#     memory   -> in-memory map (default when no AWS region is set)
#     dynamodb -> Amazon DynamoDB table (uses the standard AWS credential chain)
#     auto     -> dynamodb when AWS_REGION or DYNAMODB_ENDPOINT is set, else memory
# Create the table + TTL once with: npm run dynamo:setup -w server
# Credentials come from the standard AWS chain (env vars, ~/.aws/credentials,
# SSO, or an instance/role). AWS_REGION is required for the real service.
PENDING_ACTION_STORE=auto
AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
DYNAMODB_PENDING_ACTIONS_TABLE=lifepilot_pending_actions
# Point at DynamoDB Local for offline dev/testing:
# DYNAMODB_ENDPOINT=http://localhost:8000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_CHAT_MAX=30

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Seed the DB with a demo account on `npm run seed` (credentials below in README)
DEMO_SEED=true
DEMO_EMAIL=demo@lifepilot.app
DEMO_PASSWORD=demo1234